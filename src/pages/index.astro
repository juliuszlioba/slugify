---
import "../styles/global.css";
import Slugify from "../components/Slugify.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Slugify</title>
	</head>
	<body class="bg-gray-950 text-white font-sans antialiased selection:bg-white/20">
		<main class="flex min-h-dvh w-full items-center justify-center px-4 py-24 md:p-8">
			<div class="w-full max-w-2xl">
				<Slugify />
			</div>
		</main>
	</body>
</html>
